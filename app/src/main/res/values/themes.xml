<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- AppCompat, not Material Components. MainActivity extends AppCompatActivity so the
         per-app language backport works below API 33, and that backport requires an AppCompat
         theme. Compose draws everything above this, so the theme only supplies the window. -->
    <style name="Theme.KabutarBaazi" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@color/window_background</item>
    </style>
</resources>
